# ---- Application ----
APP_NAME=NexusSSD
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database ----
# In Docker Compose the host is the service name "db"; locally use "localhost".
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# ---- CORS (comma-separated origins the API accepts) ----
CORS_ORIGINS=http://localhost:5173

# ---- AI providers (used from Phase 4 onward) ----
# Leave OPENAI_API_KEY blank to use the local/offline fallback.
OPENAI_API_KEY=
LLM_PROVIDER=auto           # auto | openai | local
EMBEDDING_DIM=1536          # 1536 for OpenAI text-embedding-3-small; 384 for local MiniLM

# ---- ML ----
MODEL_ARTIFACT_DIR=ml/artifacts
PREDICTION_HORIZON_DAYS=30
